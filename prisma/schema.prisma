generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

/// What kind of post this is. SALE/RENT are items; STORAGE is "I'll store your
/// stuff"; WANTED is a buyer looking for something; SUBLET links housing.
enum ListingKind {
  SALE
  RENT
  STORAGE
  WANTED
  SUBLET
}

enum Category {
  FURNITURE
  APPLIANCES
  BIKES
  ELECTRONICS
  KITCHEN
  TEXTBOOKS
  CLOTHING
  BEDDING
  DECOR
  SPORTS
  STORAGE_SPACE
  HOUSING
  OTHER
}

enum Condition {
  NEW
  GOOD
  WORN
}

enum PriceUnit {
  FLAT
  PER_DAY
  PER_WEEK
  PER_MONTH
  PER_TERM
}

enum ListingStatus {
  ACTIVE
  RESERVED
  SOLD
  UNAVAILABLE
  REMOVED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum TokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  program            String?
  year               Int?
  emailVerifiedAt    DateTime?
  role               Role      @default(USER)
  bannedAt           DateTime?
  banReason          String?
  emailNotifications Boolean   @default(true)
  createdAt          DateTime  @default(now())

  sessions         Session[]
  tokens           EmailToken[]
  listings         Listing[]
  bundles          Bundle[]
  requests         ListingRequest[]
  buyerChats       Conversation[]   @relation("buyer")
  sellerChats      Conversation[]   @relation("seller")
  messages         Message[]
  reviewsWritten   Review[]         @relation("reviewer")
  reviewsReceived  Review[]         @relation("reviewee")
  reportsFiled     Report[]         @relation("reporter")
  reportsAgainst   Report[]         @relation("reportedUser")
  reportsResolved  Report[]         @relation("resolver")
  favorites        Favorite[]
  notifications    Notification[]
  alerts           Alert[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// "Leaving for co-op" bundle: several listings sharing a move-out deadline.
model Bundle {
  id            String    @id @default(cuid())
  ownerId       String
  title         String
  description   String    @default("")
  moveOutDate   DateTime  @db.Date
  neighbourhood String
  createdAt     DateTime  @default(now())
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings      Listing[]

  @@index([ownerId])
}

model Listing {
  id             String        @id @default(cuid())
  ownerId        String
  kind           ListingKind
  title          String
  description    String        @default("")
  category       Category
  condition      Condition?
  /// For WANTED posts this is the maximum budget.
  priceCents     Int
  priceUnit      PriceUnit     @default(FLAT)
  /// Deposit the owner asks for; handled in person, tracked for information.
  depositCents   Int?
  neighbourhood  String
  status         ListingStatus @default(ACTIVE)
  /// Rental / storage / sublet / wanted window.
  availableFrom  DateTime?     @db.Date
  availableUntil DateTime?     @db.Date
  /// SUBLET: which city the place is in, plus an optional external link.
  city           String?
  externalUrl    String?
  bundleId       String?
  expiresAt      DateTime
  expiryWarnedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bundle        Bundle?          @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  photos        ListingPhoto[]
  requests      ListingRequest[]
  conversations Conversation[]
  favorites     Favorite[]
  reports       Report[]

  @@index([status, createdAt])
  @@index([ownerId])
  @@index([bundleId])
  @@index([category])
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  /// File name inside UPLOAD_DIR.
  key       String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

/// A request to buy (no dates) or rent/store (with dates) a listing.
/// Overlapping ACCEPTED/COMPLETED date ranges on the same listing are rejected
/// by a Postgres exclusion constraint (see the init migration).
model ListingRequest {
  id          String        @id @default(cuid())
  listingId   String
  requesterId String
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  message     String        @default("")
  status      RequestStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester User     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  reviews   Review[]

  @@index([listingId, status])
  @@index([requesterId])
}

model Conversation {
  id            String    @id @default(cuid())
  listingId     String
  buyerId       String
  sellerId      String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer         User      @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller        User      @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Review {
  id         String         @id @default(cuid())
  requestId  String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String         @default("")
  createdAt  DateTime       @default(now())
  request    ListingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer   User           @relation("reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee   User           @relation("reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([requestId, reviewerId])
  @@index([revieweeId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  listingId      String?
  reportedUserId String?
  reason         String
  details        String       @default("")
  status         ReportStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  reporter       User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  listing        Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reportedUser   User?        @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  resolvedBy     User?        @relation("resolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String    @default("")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Saved search: "notify me when a desk is posted under $40".
model Alert {
  id            String       @id @default(cuid())
  userId        String
  keyword       String?
  category      Category?
  kind          ListingKind?
  maxPriceCents Int?
  neighbourhood String?
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([userId])
}

/// Sliding-window rate limit hits, keyed like "login:ip:1.2.3.4".
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
