# Postgres. `npm run db:dev` starts a local one at this URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/waterloo_market"

# Public base URL, used in email links.
APP_URL="http://localhost:3000"

# Comma-separated email domains allowed to sign up.
ALLOWED_EMAIL_DOMAINS="uwaterloo.ca"

# Shown on /privacy and /terms for privacy requests and questions. Required in production.
CONTACT_EMAIL=""

# Accounts with these emails become admins when they sign up / verify.
ADMIN_EMAILS=""

# Email delivery. With neither set, emails print to the server console.
EMAIL_FROM="Waterloo Market <no-reply@example.com>"
RESEND_API_KEY=""
# SMTP_URL="smtps://user:pass@smtp.example.com:465"

# Protects /api/cron/daily. Call it once a day with: Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# Where uploaded photos are stored (relative to the project root, or absolute).
UPLOAD_DIR="uploads"
